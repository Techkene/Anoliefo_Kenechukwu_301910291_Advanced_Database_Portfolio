digraph AquaSense {
  graph [rankdir=LR, fontname="Helvetica", bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.9,
         label="AquaSense+ — Entity Relationship Diagram (crow's-foot notation, PK = primary key, FK = foreign key)", labelloc=t, fontsize=18];
  node  [shape=plain, fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=9, color="#3b5b7a", arrowsize=0.8];

  state [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e8eef5"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>state</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="state_code"><B>PK state_code</B></TD></TR><TR><TD ALIGN="LEFT" PORT="state_name">state_name</TD></TR><TR><TD ALIGN="LEFT" PORT="geo_zone">geo_zone</TD></TR></TABLE>>];
  cooperative [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf1e3"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>cooperative</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="coop_id"><B>PK coop_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="coop_name">coop_name</TD></TR><TR><TD ALIGN="LEFT" PORT="state_code">FK state_code</TD></TR><TR><TD ALIGN="LEFT" PORT="registered_on">registered_on</TD></TR></TABLE>>];
  app_user [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf1e3"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>app_user</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><B>PK user_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="full_name">full_name</TD></TR><TR><TD ALIGN="LEFT" PORT="">phone (UQ)</TD></TR><TR><TD ALIGN="LEFT" PORT="role">role</TD></TR><TR><TD ALIGN="LEFT" PORT="coop_id">FK coop_id</TD></TR><TR><TD ALIGN="LEFT" PORT="preferred_language">preferred_language</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at">created_at</TD></TR></TABLE>>];
  farm [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf1e3"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>farm</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="farm_id"><B>PK farm_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="owner_id">FK owner_id</TD></TR><TR><TD ALIGN="LEFT" PORT="farm_name">farm_name</TD></TR><TR><TD ALIGN="LEFT" PORT="state_code">FK state_code</TD></TR><TR><TD ALIGN="LEFT" PORT="lga">lga</TD></TR><TR><TD ALIGN="LEFT" PORT="latitude">latitude</TD></TR><TR><TD ALIGN="LEFT" PORT="longitude">longitude</TD></TR></TABLE>>];
  farm_staff [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fdf1e3"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>farm_staff</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="farm_id"><B>PK,FK farm_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="user_id"><B>PK,FK user_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="staff_role">staff_role</TD></TR><TR><TD ALIGN="LEFT" PORT="joined_on">joined_on</TD></TR></TABLE>>];
  culture_unit [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f4ea"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>culture_unit</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_id"><B>PK unit_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="farm_id">FK farm_id</TD></TR><TR><TD ALIGN="LEFT" PORT="unit_code">unit_code</TD></TR><TR><TD ALIGN="LEFT" PORT="unit_type">unit_type</TD></TR><TR><TD ALIGN="LEFT" PORT="volume_m3">volume_m3</TD></TR><TR><TD ALIGN="LEFT" PORT="has_sensor">has_sensor</TD></TR><TR><TD ALIGN="LEFT" PORT="is_active">is_active</TD></TR></TABLE>>];
  species [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e8eef5"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>species</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="species_id"><B>PK species_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="common_name">common_name</TD></TR><TR><TD ALIGN="LEFT" PORT="scientific_name">scientific_name</TD></TR><TR><TD ALIGN="LEFT" PORT="target_weight_g">target_weight_g</TD></TR><TR><TD ALIGN="LEFT" PORT="typical_cycle_days">typical_cycle_days</TD></TR></TABLE>>];
  stock_batch [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e6f4ea"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>stock_batch</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="batch_id"><B>PK batch_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_id">FK unit_id</TD></TR><TR><TD ALIGN="LEFT" PORT="species_id">FK species_id</TD></TR><TR><TD ALIGN="LEFT" PORT="stocked_on">stocked_on</TD></TR><TR><TD ALIGN="LEFT" PORT="initial_count">initial_count</TD></TR><TR><TD ALIGN="LEFT" PORT="initial_avg_weight_g">initial_avg_weight_g</TD></TR><TR><TD ALIGN="LEFT" PORT="fingerling_unit_cost">fingerling_unit_cost</TD></TR><TR><TD ALIGN="LEFT" PORT="status">status</TD></TR><TR><TD ALIGN="LEFT" PORT="closed_on">closed_on</TD></TR></TABLE>>];
  feed_product [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e8eef5"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>feed_product</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="feed_id"><B>PK feed_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="brand">brand</TD></TR><TR><TD ALIGN="LEFT" PORT="pellet_size_mm">pellet_size_mm</TD></TR><TR><TD ALIGN="LEFT" PORT="protein_pct">protein_pct</TD></TR><TR><TD ALIGN="LEFT" PORT="bag_kg">bag_kg</TD></TR></TABLE>>];
  feed_inventory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fce4ec"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>feed_inventory</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="farm_id"><B>PK,FK farm_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="feed_id"><B>PK,FK feed_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="">qty_kg (≥0)</TD></TR><TR><TD ALIGN="LEFT" PORT="updated_at">updated_at</TD></TR></TABLE>>];
  feed_purchase [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fce4ec"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>feed_purchase</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="purchase_id"><B>PK purchase_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="farm_id">FK farm_id</TD></TR><TR><TD ALIGN="LEFT" PORT="feed_id">FK feed_id</TD></TR><TR><TD ALIGN="LEFT" PORT="bags">bags</TD></TR><TR><TD ALIGN="LEFT" PORT="price_per_bag">price_per_bag</TD></TR><TR><TD ALIGN="LEFT" PORT="purchased_on">purchased_on</TD></TR></TABLE>>];
  feeding_log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e3f2fd"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>feeding_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="feeding_id"><B>PK feeding_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="batch_id">FK batch_id</TD></TR><TR><TD ALIGN="LEFT" PORT="feed_id">FK feed_id</TD></TR><TR><TD ALIGN="LEFT" PORT="fed_on">fed_on</TD></TR><TR><TD ALIGN="LEFT" PORT="qty_kg">qty_kg</TD></TR><TR><TD ALIGN="LEFT" PORT="recorded_by">FK recorded_by</TD></TR></TABLE>>];
  mortality_log [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e3f2fd"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>mortality_log</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mortality_id"><B>PK mortality_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="batch_id">FK batch_id</TD></TR><TR><TD ALIGN="LEFT" PORT="recorded_on">recorded_on</TD></TR><TR><TD ALIGN="LEFT" PORT="dead_count">dead_count</TD></TR><TR><TD ALIGN="LEFT" PORT="suspected_cause">suspected_cause</TD></TR><TR><TD ALIGN="LEFT" PORT="recorded_by">FK recorded_by</TD></TR></TABLE>>];
  growth_sample [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e3f2fd"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>growth_sample</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sample_id"><B>PK sample_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="batch_id">FK batch_id</TD></TR><TR><TD ALIGN="LEFT" PORT="sampled_on">sampled_on</TD></TR><TR><TD ALIGN="LEFT" PORT="sample_size">sample_size</TD></TR><TR><TD ALIGN="LEFT" PORT="avg_weight_g">avg_weight_g</TD></TR></TABLE>>];
  water_quality_reading [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#e3f2fd"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>water_quality_reading</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="reading_id"><B>PK reading_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="unit_id">FK unit_id</TD></TR><TR><TD ALIGN="LEFT" PORT="recorded_at">recorded_at</TD></TR><TR><TD ALIGN="LEFT" PORT="ph">ph</TD></TR><TR><TD ALIGN="LEFT" PORT="dissolved_oxygen_mgl">dissolved_oxygen_mgl</TD></TR><TR><TD ALIGN="LEFT" PORT="temperature_c">temperature_c</TD></TR><TR><TD ALIGN="LEFT" PORT="ammonia_mgl">ammonia_mgl</TD></TR><TR><TD ALIGN="LEFT" PORT="source">source</TD></TR></TABLE>>];
  harvest [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fce4ec"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>harvest</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="harvest_id"><B>PK harvest_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="batch_id">FK batch_id</TD></TR><TR><TD ALIGN="LEFT" PORT="harvested_on">harvested_on</TD></TR><TR><TD ALIGN="LEFT" PORT="fish_count">fish_count</TD></TR><TR><TD ALIGN="LEFT" PORT="total_weight_kg">total_weight_kg</TD></TR><TR><TD ALIGN="LEFT" PORT="is_partial">is_partial</TD></TR></TABLE>>];
  sale [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fce4ec"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>sale</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sale_id"><B>PK sale_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="harvest_id">FK harvest_id</TD></TR><TR><TD ALIGN="LEFT" PORT="trader_id">FK trader_id</TD></TR><TR><TD ALIGN="LEFT" PORT="buyer_name">buyer_name</TD></TR><TR><TD ALIGN="LEFT" PORT="qty_kg">qty_kg</TD></TR><TR><TD ALIGN="LEFT" PORT="price_per_kg">price_per_kg</TD></TR><TR><TD ALIGN="LEFT" PORT="sold_on">sold_on</TD></TR><TR><TD ALIGN="LEFT" PORT="payment_status">payment_status</TD></TR></TABLE>>];
  expense [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#fce4ec"><TR><TD BGCOLOR="#0b3a5c"><FONT COLOR="white"><B>expense</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="expense_id"><B>PK expense_id</B></TD></TR><TR><TD ALIGN="LEFT" PORT="farm_id">FK farm_id</TD></TR><TR><TD ALIGN="LEFT" PORT="batch_id">FK batch_id</TD></TR><TR><TD ALIGN="LEFT" PORT="category">category</TD></TR><TR><TD ALIGN="LEFT" PORT="amount">amount</TD></TR><TR><TD ALIGN="LEFT" PORT="spent_on">spent_on</TD></TR></TABLE>>];
  state -> cooperative [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  state -> farm [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  cooperative -> app_user [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N (optional)"];
  app_user -> farm [arrowhead=crowodot, arrowtail=teetee, dir=both, label="owns 1:N"];
  farm -> farm_staff [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  app_user -> farm_staff [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  farm -> culture_unit [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  culture_unit -> stock_batch [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N (≤1 active)"];
  species -> stock_batch [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  stock_batch -> feeding_log [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  feed_product -> feeding_log [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  stock_batch -> mortality_log [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  stock_batch -> growth_sample [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  culture_unit -> water_quality_reading [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  stock_batch -> harvest [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  harvest -> sale [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  app_user -> sale [arrowhead=crowodot, arrowtail=teetee, dir=both, label="trader 0..1:N"];
  farm -> feed_inventory [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  feed_product -> feed_inventory [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  farm -> feed_purchase [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  feed_product -> feed_purchase [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  farm -> expense [arrowhead=crowodot, arrowtail=teetee, dir=both, label="1:N"];
  stock_batch -> expense [arrowhead=crowodot, arrowtail=teetee, dir=both, label="0..1:N"];
}